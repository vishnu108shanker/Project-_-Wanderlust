<% layout("layouts/boilerplate") %>

<div class="error-wrapper text-center my-5 py-5">

  <div class="mb-4">
    <i class="fa-solid fa-person-digging fa-4x text-warning"></i>
  </div>

  <h1 class="error-title mb-3" style="font-size: 2.2rem; font-weight: 800; letter-spacing: -1px;">Feature Coming Soon</h1>
  
  <p class="error-msg text-muted mx-auto" style="max-width: 500px; font-size: 1.1rem; line-height: 1.5;">
    Oops! You've discovered an area under construction. This feature has not yet been implemented by <strong>@the_evil_lord</strong>. Stay tuned for future updates!
  </p>

  <div class="mt-4 pt-3">
    <button onclick="history.back()" class="btn btn-primary px-5 py-2 fw-bold text-uppercase" style="letter-spacing:1px; border-radius: 999px;">
      <i class="fa-solid fa-arrow-left me-2"></i> Go Back
    </button>
  </div>

</div>
