<!-- Flash Toast Messages -->
<div class="flash-toast" id="flashToastContainer">

  <% if (success && success.length > 0) { %>
  <div class="toast-msg success" id="toastSuccess">
    <div class="toast-icon"><i class="fa-solid fa-circle-check"></i></div>
    <div class="toast-body">
      <div class="toast-title">Success</div>
      <div class="toast-text"><%= success %></div>
    </div>
    <button class="toast-close" onclick="dismissToast('toastSuccess')" aria-label="Close">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
  <% } %>

  <% if (error && error.length > 0) { %>
  <div class="toast-msg error" id="toastError">
    <div class="toast-icon"><i class="fa-solid fa-circle-exclamation"></i></div>
    <div class="toast-body">
      <div class="toast-title">Error</div>
      <div class="toast-text"><%= error %></div>
    </div>
    <button class="toast-close" onclick="dismissToast('toastError')" aria-label="Close">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
  <% } %>

</div>
