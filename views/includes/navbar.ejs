<nav class="navbar" id="mainNavbar">
  <div class="container-fluid px-2 px-sm-4 d-flex align-items-center justify-content-between">

    <!-- ── Brand (Left) ──────────────────────────────────────── -->
    <a class="navbar-brand d-flex align-items-center gap-2" href="/listings" id="navBrand">
      <i class="fa-solid fa-route fa-2x" style="color: var(--accent);"></i>
      <span class="brand-name d-none d-md-block ms-1" style="font-size: 1.45rem;">Graveller</span>
    </a>

    <!-- ── Search Box (Center) ─────────────────────────────── -->
    <form class="d-flex mx-auto" style="flex:1; max-width:400px; padding:0 12px;" action="/listings" method="GET" id="navSearchForm">
      <div class="navbar-search w-100 m-0">
        <i class="fa-solid fa-magnifying-glass ps-2" style="color:var(--gray-400);font-size:13px;flex-shrink:0;"></i>
        <input type="text" name="search" placeholder="Search destinations…" aria-label="Search destinations" id="navSearchInput" style="height:44px; margin-left:4px;" value="<%= typeof searchQuery !== 'undefined' && searchQuery ? searchQuery : '' %>">
        <button type="submit" class="search-btn" aria-label="Search">
          <i class="fa-solid fa-magnifying-glass" style="font-size:13px;"></i>
        </button>
      </div>
    </form>

    <!-- ── User Profile & Profile Pill (Right) ──────────────── -->
    <div class="d-flex align-items-center justify-content-end gap-1 gap-md-2" style="min-width: 140px;">
      
      <!-- Host link hidden on mobile -->
      <a href="/listings/new" class="nav-link fw-bold px-3 py-2 rounded-pill d-none d-lg-block text-dark hover-bg-gray">Gravel your home</a>

      <!-- Profile Interactive Pill -->
      <div class="dropdown">
        <div class="nav-menu-btn" data-bs-toggle="dropdown" aria-expanded="false" style="cursor: pointer;">
          <i class="fa-solid fa-bars ps-1"></i>
          
          <% if (typeof currentuser !== 'undefined' && currentuser) { %>
            <div class="user-avatar-mini" style="background:#2d2d2d;"><%= currentuser.username.charAt(0).toUpperCase() %></div>
          <% } else { %>
            <div class="user-avatar-mini" style="background:var(--gray-500);">
              <i class="fa-solid fa-user text-white" style="font-size:12px;"></i>
            </div>
          <% } %>

        </div>
        
        <!-- The actual dropdown menu -->
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" style="border-radius:12px; min-width: 240px; padding: 8px 0;">
          
          <% if (typeof currentuser === 'undefined' || !currentuser) { %>
            <li><a class="dropdown-item fw-bold" href="/signup">Sign up</a></li>
            <li><a class="dropdown-item" href="/login">Log in</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/listings/new">Gravel your home</a></li>
            <li><a class="dropdown-item" href="/feature-not-implemented">Help</a></li>
          
          <% } else { %>
            <li><a class="dropdown-item fw-bold" href="/feature-not-implemented">Messages</a></li>
            <li><a class="dropdown-item fw-bold" href="/feature-not-implemented">Trips</a></li>
            <li><a class="dropdown-item fw-bold" href="/feature-not-implemented">Wishlists</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/listings/new">Gravel your home</a></li>
            <li><a class="dropdown-item" href="/feature-not-implemented">Account</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/logout">Log out</a></li>
          <% } %>
          
        </ul>
      </div>

    </div>
  </div><!-- /container -->
</nav>
