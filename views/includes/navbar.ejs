<nav class="navbar navbar-expand-lg" id="mainNavbar">
  <div class="container-fluid px-4">

    <!-- ── Brand ─────────────────────────────────────────── -->
    <a class="navbar-brand d-flex align-items-center gap-2" href="/listings" id="navBrand">
      <i class="fa-solid fa-route fa-lg"></i>
      <span class="brand-name">Graveller</span>
    </a>

    <!-- ── Mobile toggler ────────────────────────────────── -->
    <button class="navbar-toggler border-0 shadow-none" type="button"
      data-bs-toggle="collapse" data-bs-target="#navCollapse"
      aria-controls="navCollapse" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- ── Collapsible content ────────────────────────────── -->
    <div class="collapse navbar-collapse" id="navCollapse">

      <!-- ── Centre: Search pill ──────────────────────────── -->
      <form class="d-flex mx-auto" action="/listings" method="GET" id="navSearchForm">
        <div class="navbar-search">
          <i class="fa-solid fa-magnifying-glass" style="color:var(--gray-400);font-size:13px;flex-shrink:0;"></i>
          <input
            type="text"
            name="search"
            placeholder="Search destinations…"
            aria-label="Search destinations"
            id="navSearchInput"
          >
          <button type="submit" class="search-btn" aria-label="Search">
            <i class="fa-solid fa-magnifying-glass" style="font-size:13px;"></i>
          </button>
        </div>
      </form>

      <!-- ── Right: Actions ───────────────────────────────── -->
      <ul class="navbar-nav ms-auto align-items-center gap-1">

        <!-- Host your home -->
        <li class="nav-item">
          <a href="/listings/new" class="nav-link nav-btn nav-btn-ghost d-none d-lg-block" id="navHostLink">
            Gravel your home
          </a>
        </li>

        <% if (!currentuser) { %>
          <!-- Sign Up -->
          <li class="nav-item">
            <a href="/signup" class="nav-btn nav-btn-primary" id="navSignupBtn">Sign up</a>
          </li>
          <!-- Login -->
          <li class="nav-item">
            <a href="/login" class="nav-btn nav-btn-outline" id="navLoginBtn">Log in</a>
          </li>
        <% } else { %>
          <!-- Logged-in user pill -->
          <li class="nav-item">
            <div class="nav-menu-btn" id="navUserMenu">
              <i class="fa-solid fa-bars"></i>
              <div class="user-avatar-mini" aria-label="User menu">
                <%= currentuser.username.charAt(0).toUpperCase() %>
              </div>
            </div>
          </li>
          <!-- Logout -->
          <li class="nav-item">
            <a href="/logout" class="nav-btn nav-btn-danger" id="navLogoutBtn">Log out</a>
          </li>
        <% } %>

      </ul>
    </div><!-- /collapse -->
  </div><!-- /container -->
</nav>
