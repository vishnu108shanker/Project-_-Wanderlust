<% layout("layouts/boilerplate") %>

<div class="container mt-4">
  
  <!-- ── MINIMAL PAGE HEADER ─────────────────────────────────── -->
  <div class="mb-4 mt-2">
    <h1 class="fw-bold mb-1" style="font-size:2rem; letter-spacing:-0.5px; color: var(--gray-900);">Discover your next adventure</h1>
    <p class="text-muted" style="font-size:1.05rem;">Unique homes, cozy cabins, and stunning beachhouses await.</p>
  </div>

  <!-- ── CATEGORY FILTER ───────────────────────────────────── -->
  <div class="category-bar">
    <div class="cat-item active">
      <i class="fa-solid fa-fire"></i>
      <span>Trending</span>
    </div>
    <div class="cat-item">
      <i class="fa-solid fa-umbrella-beach"></i>
      <span>Beaches</span>
    </div>
    <div class="cat-item">
      <i class="fa-solid fa-mountain-sun"></i>
      <span>Mountains</span>
    </div>
    <div class="cat-item">
      <i class="fa-brands fa-fort-awesome"></i>
      <span>Castles</span>
    </div>
    <div class="cat-item">
      <i class="fa-solid fa-snowflake"></i>
      <span>Arctic</span>
    </div>
    <div class="cat-item">
      <i class="fa-solid fa-tractor"></i>
      <span>Farms</span>
    </div>
    <div class="cat-item">
      <i class="fa-solid fa-water-ladder"></i>
      <span>Pools</span>
    </div>
    <div class="cat-item">
      <i class="fa-solid fa-campground"></i>
      <span>Camping</span>
    </div>
    <div class="cat-item">
      <i class="fa-solid fa-city"></i>
      <span>Cities</span>
    </div>
  </div>

  <!-- ── LISTINGS GRID ─────────────────────────────────────── -->
  <div class="section-header">
    <h2>Explore Stays</h2>
  </div>

  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mt-1 mb-5">
    <% for (let data of datum) { %>
      <div class="col">
        <a href="/listings/<%= data._id %>" class="text-decoration-none">
          <div class="listing-card">
            
            <div class="img-wrap">
              <button class="wishlist-btn" aria-label="Add to wishlist">
                <i class="fa-regular fa-heart"></i>
              </button>
              <img src="<%= data.image && data.image.url ? data.image.url : 'https://images.unsplash.com/photo-1501117716987-c8e68a736a3f?auto=format&fit=crop&w=600&q=80' %>" alt="<%= data.title %>">
              <div class="price-badge">$<%= data.price %> <span>/ night</span></div>
            </div>

            <div class="card-body">
              <div class="card-meta">
                <div class="card-location">
                  <i class="fa-solid fa-location-dot"></i> <%= data.location || 'Unknown' %>
                </div>
                <div class="card-rating">
                  <i class="fa-solid fa-star"></i> 4.8
                </div>
              </div>
              <h3 class="card-title mt-2"><%= data.title.length > 40 ? data.title.substring(0, 40) + '...' : data.title %></h3>
            </div>
            
          </div>
        </a>
      </div>
    <% } %>

    <% if (!datum || datum.length === 0) { %>
      <div class="col-12 text-center py-5">
        <h3 class="text-muted">No stays found.</h3>
        <p>Try exploring another category!</p>
      </div>
    <% } %>
  </div>

</div>
