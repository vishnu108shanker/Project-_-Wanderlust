<% layout("layouts/boilerplate") %>

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-logo justify-content-center">
      <i class="fa-solid fa-route fa-lg"></i>
      <span class="brand-name">Graveller</span>
    </div>
    
    <h2 class="text-center fw-bold">Welcome back</h2>
    <p class="auth-subtitle text-center">Log in to book your next getaway.</p>

    <form action="/login" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="email" class="form-label">Email address</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="name@example.com" required autofocus>
        <div class="invalid-feedback">Please enter a valid email.</div>
      </div>

      <div class="mb-4">
        <label for="password" class="form-label">Password</label>
        <input type="password" id="password" name="password" class="form-control" placeholder="Enter your password" required>
        <div class="invalid-feedback">Please enter your password.</div>
      </div>

      <button type="submit" class="btn btn-primary btn-block py-2 fw-bold">Log in to Graveller</button>
    </form>

    <div class="auth-divider">or seamlessly log in with</div>

    <div class="d-flex gap-3 mb-4">
      <button class="btn btn-outline-secondary w-100 fw-semi py-2" type="button"><i class="fa-brands fa-google text-danger me-2"></i> Google</button>
      <button class="btn btn-outline-secondary w-100 fw-semi py-2" type="button"><i class="fa-brands fa-apple me-2 fs-5" style="vertical-align:-2px;"></i> Apple</button>
    </div>

    <div class="auth-footer">
      Don't have an account? <a href="/signup">Sign up</a>
    </div>
  </div>
</div>
